<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WslManager</RootNamespace>
    <AssemblyName>WslManager</AssemblyName>
    <MyType>Empty</MyType>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>WSL 状态管理器</Product>
    <Company>billchen</Company>
    <Description>WSL 发行版开关机状态控制小工具</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 跨电脑分发：允许在已装 .NET 9/10 桌面运行时（无 8.0）的机器上直接运行，
         不必强制安装 .NET 8 Desktop Runtime -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 入口 XAML 名为 App.xaml，需显式声明（默认只识别 Application.xaml） -->
    <Page Remove="App.xaml" />
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

</Project>
