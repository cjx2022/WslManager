<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ShadowColor">#FF000000</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202023"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3A3A3E"/>

    <!-- 自绘的 Mica 质感：顶部略亮、底部略沉，模拟云母材质的层次 -->
    <LinearGradientBrush x:Key="MicaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B2B2F" Offset="0"/>
        <GradientStop Color="#242427" Offset="0.55"/>
        <GradientStop Color="#1E1E21" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838"/>
    <SolidColorBrush x:Key="MenuBrush" Color="#2B2B2B"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8F8F8F"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6ACEFF"/>

    <SolidColorBrush x:Key="SubtleBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#363636"/>
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#2E2E2E"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#57C257"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7B72"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E3B341"/>

    <SolidColorBrush x:Key="SeparatorBrush" Color="#353535"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#12303F"/>
</ResourceDictionary>
