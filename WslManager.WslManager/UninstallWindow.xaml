<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WslManager.UI.UninstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:h="clr-namespace:WslManager.Helpers" x:Name="Root" Title="卸载 WSL 发行版" Width="900" Height="680" MinWidth="720" MinHeight="540" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <h:BoolToVisibilityConverter x:Key="BoolVis" />

      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="{DynamicResource MicaBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#x25C6;" FontSize="11" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Text="卸载 WSL 发行版（导出备份后卸载）" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="CloseButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,6,24,20">
        <StackPanel>
          <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="1. 选择发行版" Style="{StaticResource SectionTitle}" />
                  <TextBlock Style="{StaticResource Sec}" FontSize="12" Text="wsl -l -v 读取本机已安装的发行版（名称保持裸名拼接，不加引号）。" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="Refresh_Click" Content="刷新列表" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Name="DistroCombo" MinWidth="320" Padding="8,6" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" DisplayMemberPath="Name" SelectionChanged="DistroCombo_Changed" />
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Click="UnregisterDoc_Click" Content="卸载文档" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Tert}" FontSize="12" Text="安装路径" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Name="PathValue" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Style="{StaticResource Tert}" FontSize="12" Text="占用空间" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Grid.Column="3" Name="SizeValue" Style="{StaticResource Sec}" FontSize="12" Text="—" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Name="StateValue" Style="{StaticResource Sec}" FontSize="12" Margin="0,8,0,0" Text="—" />
            </StackPanel>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,14,0,0" />
          <StackPanel Margin="0,14,0,0">
              <TextBlock Text="2. 导出备份" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Sec}" FontSize="12" Text="导出备份：把整个发行版打包为 .tar，可在日后恢复。" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="ExportBox" Padding="7,6" FontFamily="{StaticResource MonoFont}" FontSize="12" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" />
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="Browse_Click" Content="浏览…" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Export_Click" Content="导出备份" />
                <Button Grid.Column="3" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ExportDoc_Click" Content="导出文档" />
              </Grid>
              <TextBlock Style="{StaticResource Tert}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Text="提示：导出文件可能达到数 GB，请确保目标磁盘空间充足；导出期间该发行版不可正在写入数据。" />
            </StackPanel>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,14,0,0" />
          <StackPanel Margin="0,14,0,0">
              <TextBlock Text="3. 确认卸载" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Style="{StaticResource Sec}" FontSize="12" TextWrapping="Wrap" Text="卸载会永久删除该发行版及其全部数据、快照与快照分层（不会被回收站保留）。请先导出备份。" />
              <CheckBox Name="AutoExportCheck" Style="{StaticResource ToggleSwitch}" Content="卸载前自动执行一次导出备份" IsChecked="True" Margin="0,12,0,0" />
              <CheckBox Name="ConfirmCheck" Style="{StaticResource ToggleSwitch}" Content="我已知晓卸载将永久删除该发行版的全部数据" Margin="0,8,0,0" Checked="Confirm_Changed" Unchecked="Confirm_Changed" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Sec}" FontSize="12">
                  <Run Text="输入发行版名称" /><Run Text=" 以确认：" />
                </TextBlock>
                <TextBox Name="ConfirmNameBox" Padding="7,6" FontFamily="{StaticResource MonoFont}" FontSize="12" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Text="" TextChanged="Confirm_Changed" />
              </Grid>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="ConfirmHint" IsReadOnly="True" Padding="0" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="勾选确认并输入完全一致的发行版名称后，卸载按钮才会启用。" />
                <Button Grid.Column="1" Name="UninstallBtn" Style="{StaticResource DangerButton}" Margin="16,0,0,0" Padding="18,7" IsEnabled="False" Click="Uninstall_Click" Content="卸载" />
              </Grid>
            </StackPanel>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,14,0,0" />
          <StackPanel Margin="0,14,0,0">
              <TextBlock Text="操作日志" Style="{StaticResource SectionTitle}" />
              <TextBox Name="LogBox" Height="120" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Background="{DynamicResource SubtleBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="8,6" />
            </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="StatusMessage" Style="{StaticResource Sec}" FontSize="12" VerticalAlignment="Center" Text="就绪" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="ProgressLabel" Style="{StaticResource Tert}" FontSize="11.5" Margin="0,0,10,0" />
            <ProgressBar Name="WorkProgress" Width="180" Height="6" Minimum="0" Maximum="100" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
