<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WslManager.UI.InstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:h="clr-namespace:WslManager.Helpers" x:Name="Root" Title="安装 WSL 发行版" Width="940" Height="700" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <h:BoolToVisibilityConverter x:Key="BoolVis" />

      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style x:Key="LinkText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Sec}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextDecorations" Value="Underline" />
      </Style>
      <DataTemplate x:Key="SourceRow">
        <StackPanel>
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="285" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Tert}" FontSize="11.5" Text="{Binding Location}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Style="{StaticResource Sec}" FontSize="12" Text="{Binding SpeedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SpeedText}" />
            <Button Grid.Column="3" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="9,3" Tag="{Binding}" Click="SpeedOne_Click" Content="测速" Visibility="{Binding CanSpeed, Converter={StaticResource BoolVis}}" />
            <Button Grid.Column="4" Style="{StaticResource AccentButton}" Padding="11,3" Tag="{Binding}" Click="InstallOne_Click" Content="下载安装" />
          </Grid>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="{DynamicResource MicaBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#x25C6;" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Text="安装 WSL 发行版" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="CloseButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,6,24,20">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="环境检查" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Sec}" FontSize="12" Text="逐项检测本机是否满足 WSL 安装/运行条件；点击右侧按钮在独立窗口中查看详细结果。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OpenEnvCheck_Click" Content="打开环境检查" />
              <Button Style="{StaticResource ActionButton}" Click="InstallDoc_Click" Content="安装文档" />
            </StackPanel>
          </Grid>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,14,0,0" />
          <StackPanel Margin="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="安装发行版" Style="{StaticResource SectionTitle}" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="RefreshOnline_Click" Content="刷新列表" />
              <Button Grid.Column="2" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="SpeedAll_Click" Content="测速所选" />
              <Button Grid.Column="3" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Downloads_Click" Content="下载管理" />
              <Button Grid.Column="4" Name="CancelBtn" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click" Content="终止" />
              <Button Grid.Column="5" Style="{StaticResource ActionButton}" Click="MirrorDoc_Click" Content="自定义发行版文档" />
            </Grid>
            <Grid Margin="0,12,0,0">
              <ComboBox Name="DistroCombo" MinWidth="300" Padding="8,6" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" SelectionChanged="DistroCombo_Changed" />
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Name="SizeBadgeBox" Style="{StaticResource Badge}">
                  <TextBlock Name="SizeBadge" Style="{StaticResource Sec}" FontSize="11" Text="—" />
                </Border>
                <Border Name="MethodBadgeBox" Style="{StaticResource Badge}" Margin="6,0,0,0">
                  <TextBlock Name="MethodBadge" Style="{StaticResource Sec}" FontSize="11" Text="—" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Tert}" FontSize="11.5" Text="安装名称" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Name="InstallNameBox" Width="150" Padding="6,4" FontSize="12" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Text="{Binding InstallName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Border Margin="0,12,0,0" Padding="12,10,12,12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <TextBlock Name="OfficialGroupTitle" Style="{StaticResource Sec}" FontWeight="SemiBold" FontSize="12" Text="官方下载源：" />
                <ItemsControl Name="OfficialList" Margin="0,6,0,0" ItemTemplate="{StaticResource SourceRow}" />
                <TextBlock Name="MirrorGroupTitle" Style="{StaticResource Sec}" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0" Text="国内下载源：" />
                <ItemsControl Name="MirrorList" Margin="0,6,0,0" ItemTemplate="{StaticResource SourceRow}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,14,0,0" />
          <StackPanel Margin="0,14,0,0">
              <TextBlock Text="安装日志" Style="{StaticResource SectionTitle}" />
              <TextBox Name="LogBox" Height="130" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Background="{DynamicResource SubtleBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="8,6" />
            </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="StatusMessage" Style="{StaticResource Sec}" FontSize="12" VerticalAlignment="Center" Text="就绪" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="ProgressLabel" Style="{StaticResource Tert}" FontSize="11.5" Margin="0,0,10,0" />
            <ProgressBar Name="WorkProgress" Width="180" Height="6" Minimum="0" Maximum="100" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
