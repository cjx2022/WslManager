<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WslManager.UI.DownloadsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:h="clr-namespace:WslManager.Helpers" x:Name="Root" Title="下载包管理" Width="740" Height="520" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <DataTemplate x:Key="FileRow">
        <Grid Margin="0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
          <TextBlock Grid.Column="1" Style="{StaticResource Tert}" FontSize="11.5" Text="{Binding SizeText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Style="{StaticResource Tert}" FontSize="11.5" Text="{Binding DateText}" VerticalAlignment="Center" />
          <Button Grid.Column="3" Style="{StaticResource DangerButton}" Padding="9,3" Tag="{Binding FullPath}" Click="DeleteFile_Click" Content="删除" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="{DynamicResource MicaBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#x25C6;" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Text="下载包管理" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="CloseButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,6,24,20">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="下载包管理" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Sec}" FontSize="12" Text="已下载的安装包缓存；重复安装同一源时自动命中缓存，可在此删除或打开目录。" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="OpenDir_Click" Content="打开目录" />
            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Refresh_Click" Content="刷新" />
            <Button Grid.Column="3" Style="{StaticResource DangerButton}" Click="ClearAll_Click" Content="清空全部" />
          </Grid>
          <TextBlock Name="DirText" Style="{StaticResource Tert}" FontSize="11.5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="缓存目录" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="文件名" Style="{StaticResource Sec}" FontWeight="SemiBold" FontSize="11.5" />
            <TextBlock Grid.Column="1" Text="大小" Style="{StaticResource Sec}" FontWeight="SemiBold" FontSize="11.5" />
            <TextBlock Grid.Column="2" Text="修改时间" Style="{StaticResource Sec}" FontWeight="SemiBold" FontSize="11.5" />
          </Grid>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,6,0,0" />
          <ItemsControl Name="FileList" Margin="0,4,0,0" ItemTemplate="{StaticResource FileRow}" />
          <TextBlock Name="EmptyHint" Style="{StaticResource Sec}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,24,0,0" HorizontalAlignment="Center" Text="暂无已下载的安装包（执行「下载安装」时自动缓存）" Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <TextBlock Name="StatusMessage" Style="{StaticResource Sec}" FontSize="12" VerticalAlignment="Center" Text="就绪" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
