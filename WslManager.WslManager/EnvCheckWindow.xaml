<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WslManager.UI.EnvCheckWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:h="clr-namespace:WslManager.Helpers" x:Name="Root" Title="WSL 环境检查" Width="780" Height="560" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <h:BoolToVisibilityConverter x:Key="BoolVis" />
      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="{DynamicResource MicaBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#x25C6;" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Text="WSL 环境检查" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="CloseButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,6,24,20">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Text="环境检查" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Sec}" FontSize="12" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left"
                         Text="逐项检测本机是否满足 WSL 安装/运行条件。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Name="FixAllButton" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="FixAll_Click" Content="一键修复" />
              <Button Name="RecheckButton" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Recheck_Click" Content="重新检查" />
              <Button Style="{StaticResource ActionButton}" Click="InstallDoc_Click" Content="安装文档" />
            </StackPanel>
          </Grid>
          <ProgressBar Name="CheckProgress" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="状态" Style="{StaticResource Tert}" FontSize="11" />
            <TextBlock Grid.Column="1" Text="检查项" Style="{StaticResource Tert}" FontSize="11" />
            <TextBlock Grid.Column="2" Text="详情" Style="{StaticResource Tert}" FontSize="11" />
          </Grid>
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,5,0,0" />
          <ItemsControl Name="CheckList" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4" MinHeight="40">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{Binding StatusBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
                    <TextBlock Style="{StaticResource Sec}" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                    <TextBlock FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding FixMessage}"
                               Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding HasFixMessage, Converter={StaticResource BoolVis}}" />
                  </StackPanel>
                  <Button Grid.Column="3" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Padding="10,3"
                          VerticalAlignment="Top" MinHeight="30"
                          Tag="{Binding}" Click="FixItem_Click"
                          Content="{Binding FixButtonText}"
                          IsEnabled="{Binding CanFix}"
                          Visibility="{Binding CanFix, Converter={StaticResource BoolVis}}" />
                  <Button Grid.Column="4" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Padding="8,3"
                          VerticalAlignment="Top" MinHeight="30" IsEnabled="{Binding HasDoc}" Tag="{Binding DocUrl}" Click="DocLink_Click">
                    <TextBlock Text="文档" FontSize="11.5" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <TextBlock Name="StatusMessage" Style="{StaticResource Sec}" FontSize="12" VerticalAlignment="Center" Text="就绪" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>