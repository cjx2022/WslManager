<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WslManager.UI.EnvCheckWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Name="Root" Title="WSL 环境检查" Width="780" Height="560" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="{DynamicResource MicaBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#x25C6;" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Text="WSL 环境检查" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="CloseButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,6,24,20">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="环境检查" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Sec}" FontSize="12" Text="逐项检测本机是否满足 WSL 安装/运行条件；点击右侧链接查看官方文档。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Recheck_Click" Content="重新检查" />
              <Button Style="{StaticResource ActionButton}" Click="InstallDoc_Click" Content="安装文档" />
            </StackPanel>
          </Grid>
          <ProgressBar Name="CheckProgress" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          <ItemsControl Name="CheckList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Style="{StaticResource Sec}" FontSize="12" Text="{Binding Detail}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="3" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Padding="8,3" IsEnabled="{Binding HasDoc}" Tag="{Binding DocUrl}" Click="DocLink_Click">
                    <TextBlock Text="文档" FontSize="11.5" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <TextBlock Name="StatusMessage" Style="{StaticResource Sec}" FontSize="12" VerticalAlignment="Center" Text="就绪" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>