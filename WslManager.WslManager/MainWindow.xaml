<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WslManager.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:h="clr-namespace:WslManager.Helpers" x:Name="Root" Title="WSL 管理器" Width="1200" Height="760" MinWidth="1000" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True" xmlns:wslmanager="clr-namespace:WslManager.UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <h:BoolToVisibilityConverter x:Key="BoolVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="{DynamicResource MicaBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <!--
        v2.3 布局：内容铺满整窗，标题栏作为透明浮层压在顶部 42px 上。

        为什么不再用「42px 行 + 内容行」：标题行刷的是宿主 themes 里的 MicaBrush，
        内容行刷的是 Wslc 调色板里的 WindowGradient，两套底色在 y=42 处拼成一条色带
        （实测浅色 (252,252,253) → (244,246,249)，深色 Δ≈17/255，肉眼明显）。
        铺满之后整窗只有**一层**渐变，标题栏本身不画底色，色带从根上消失；
        为了让内容不被标题栏压住，WslcView 内部顶部让出 42px（见 WslcView.xaml）。
      -->
      <ContentControl Name="WslcHost" />

      <Grid Name="TitleBar" Height="42" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <!-- v2.4：28px 正式 logo（设计稿原样，主体尽量放大；42px 标题栏下仍留 7px 上下留白） -->
          <Image Name="TitleIcon" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality">
          </Image>
          <TextBlock Text="WSL 管理器" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Name="VersionText" Text="v2.0" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Width="40" ToolTip="切换浅色 / 深色主题" Click="ThemeButton_Click">
            <TextBlock Name="ThemeGlyph" Style="{StaticResource Glyph}" Text="&#xE708;" FontSize="14">
            </TextBlock>
          </Button>
          <Button Style="{StaticResource CaptionButton}" ToolTip="最小化" Click="MinButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE921;" FontSize="10" />
          </Button>
          <Button Style="{StaticResource CaptionButton}" ToolTip="最大化" Click="MaxButton_Click">
            <TextBlock Name="MaxGlyph" Style="{StaticResource Glyph}" Text="&#xE922;" FontSize="10">
            </TextBlock>
          </Button>
          <Button Style="{StaticResource CloseButton}" ToolTip="最小化到系统托盘" Click="HideButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
