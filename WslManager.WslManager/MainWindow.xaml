<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WslManager.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:h="clr-namespace:WslManager.Helpers" x:Name="Root" Title="WSL 状态管理器" Width="940" Height="640" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True" xmlns:wslmanager="clr-namespace:WslManager.UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <h:BoolToVisibilityConverter x:Key="BoolVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="{DynamicResource MicaBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Name="TitleIcon" Width="17" Height="17" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality">
          </Image>
          <TextBlock Text="WSL 状态管理器" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Width="40" ToolTip="切换浅色 / 深色主题" Click="ThemeButton_Click">
            <TextBlock Name="ThemeGlyph" Style="{StaticResource Glyph}" Text="" FontSize="14">
            </TextBlock>
          </Button>
          <Button Style="{StaticResource CaptionButton}" ToolTip="最小化" Click="MinButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="10" />
          </Button>
          <Button Style="{StaticResource CaptionButton}" ToolTip="最大化" Click="MaxButton_Click">
            <TextBlock Name="MaxGlyph" Style="{StaticResource Glyph}" Text="" FontSize="10">
            </TextBlock>
          </Button>
          <Button Style="{StaticResource CloseButton}" ToolTip="最小化到系统托盘" Click="HideButton_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Row="1" Margin="26,6,26,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="发行版" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Name="SummaryText" Style="{StaticResource Sec}" FontSize="12.5" Margin="0,4,0,0" Text="正在读取状态…">
          </TextBlock>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
          <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" ToolTip="环境检查 + 官方源 / 镜像源测速下载安装" Click="InstallWindow_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0" />
              <TextBlock Text="安装发行版" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource DangerButton}" Margin="0,0,8,0" ToolTip="导出备份后卸载发行版（需输入名称确认）" Click="UninstallWindow_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" Margin="0,0,7,0" />
              <TextBlock Text="卸载发行版" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" ToolTip="启动所有处于停止状态的发行版" Command="{Binding StartAllCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="11" Margin="0,0,7,0" />
              <TextBlock Text="全部开机" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" ToolTip="关闭所有发行版并释放 WSL 虚拟机" Command="{Binding StopAllCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="12" Margin="0,0,7,0" />
              <TextBlock Text="全部关机" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ActionButton}" Margin="0,0,16,0" ToolTip="重新读取状态（F5）" Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="12" Margin="0,0,7,0" />
              <TextBlock Text="刷新" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <CheckBox Name="AutoRefreshCheck" Style="{StaticResource ToggleSwitch}" Content="自动刷新" IsChecked="True" VerticalAlignment="Center" ToolTip="每 3 秒自动读取一次状态" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed" />
        </WrapPanel>
      </Grid>
      <ProgressBar Grid.Row="2" Height="2" IsIndeterminate="True" Background="#00FFFFFF" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,2,18,0" HorizontalContentAlignment="Center">
        <Grid>
          <ItemsControl Name="DistroList" ItemsSource="{Binding Distros}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource DistroCard}" HorizontalAlignment="Stretch" MaxWidth="900" Margin="0,6">
                  <Border.RenderTransform>
                    <TranslateTransform Y="0" />
                  </Border.RenderTransform>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource StatusDot}" Grid.Column="0" VerticalAlignment="Center" Margin="2,0,0,0">
                        <Ellipse.RenderTransform>
                          <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                      </Ellipse>
                      <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                          <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding IsDefault, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="默认" Style="{StaticResource Sec}" FontSize="11" />
                          </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Sec}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
                      </StackPanel>
                      <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Sec}" FontSize="11" Text="{Binding VersionText}" />
                      </Border>
                    </Grid>
                    <Grid Row="1" Margin="18,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Width="78" Margin="0,0,6,0" IsEnabled="{Binding CanStart}" Command="{Binding DataContext.StartCommand, ElementName=Root}" CommandParameter="{Binding Name}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="开机" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Width="78" Margin="0,0,6,0" IsEnabled="{Binding CanStop}" Command="{Binding DataContext.StopCommand, ElementName=Root}" CommandParameter="{Binding Name}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="关机" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Width="78" IsEnabled="{Binding CanStop}" Command="{Binding DataContext.RestartCommand, ElementName=Root}" CommandParameter="{Binding Name}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="重启" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" ToolTip="打开终端" Tag="{Binding Name}" Click="TerminalButton_Click">
                          <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="在资源管理器中打开文件" Tag="{Binding Name}" Click="FilesButton_Click">
                          <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="更多操作" Tag="{Binding Name}" Click="MoreButton_Click">
                          <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="15" />
                          <FrameworkElement.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="设为默认发行版" Tag="" Click="SetDefault_Click" />
                              <MenuItem Header="复制 IP 地址" Tag="" Click="CopyIp_Click" />
                              <MenuItem Header="复制发行版名称" Tag="" Click="CopyName_Click" />
                              <Separator />
                              <MenuItem Header="强制关机（不等待软关机）" Tag="" ToolTip="直接执行 wsl -t，跳过发行版内的关机流程" Click="ForceStop_Click" />
                              <Separator />
                              <MenuItem Header="卸载该发行版" Click="UninstallDistro_Click" />
                            </ContextMenu>
                          </FrameworkElement.ContextMenu>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40" Visibility="Collapsed">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,0,18">
              <TextBlock Style="{StaticResource Glyph}" Text="" FontSize="32" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Name="EmptyTitle" Text="未检测到 WSL 发行版" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center">
            </TextBlock>
            <TextBlock Name="EmptyHint" Style="{StaticResource Sec}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" Text="请先安装 WSL 并从 Microsoft Store 安装一个 Linux 发行版。">
            </TextBlock>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="4" Background="{DynamicResource StatusBarBrush}" Height="38" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <TextBlock Name="StatusMessage" Style="{StaticResource Sec}" FontSize="12" VerticalAlignment="Center" Text="就绪">
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Name="WslVersionText" Style="{StaticResource Tert}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0">
            </TextBlock>
            <TextBlock Name="LastUpdateText" Style="{StaticResource Tert}" FontSize="11.5" VerticalAlignment="Center">
            </TextBlock>
            <TextBlock Text="关于" Style="{StaticResource Sec}" FontSize="11.5" Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="About_Click" ToolTip="版本与版权信息" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>