<Window x:Class="WslManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:h="clr-namespace:WslManager.Helpers"
        x:Name="Root"
        Title="WSL 状态管理器"
        Width="940" Height="640" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" AllowsTransparency="False"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>
        <h:InverseBoolConverter x:Key="Not"/>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource MicaBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            CornerRadius="9" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 自定义标题栏 ============ -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="TitleIcon" Width="17" Height="17" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="WSL 状态管理器" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Width="40" Click="ThemeButton_Click"
                            ToolTip="切换浅色 / 深色主题">
                        <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Glyph}" Text="&#xE708;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="MinButton_Click" ToolTip="最小化">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE921;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="MaxButton_Click" ToolTip="最大化">
                        <TextBlock x:Name="MaxGlyph" Style="{StaticResource Glyph}" Text="&#xE922;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="HideButton_Click" ToolTip="最小化到系统托盘">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 头部 ============ -->
            <Grid Grid.Row="1" Margin="26,6,26,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="发行版" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Sec}" FontSize="12.5"
                               Margin="0,4,0,0" Text="正在读取状态…"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                            Command="{Binding StartAllCommand}"
                            ToolTip="启动所有处于停止状态的发行版">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Margin="0,0,7,0"/>
                            <TextBlock Text="全部开机" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                            Command="{Binding StopAllCommand}"
                            ToolTip="wsl --shutdown：关闭所有发行版并释放 WSL 虚拟机">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="12" Margin="0,0,7,0"/>
                            <TextBlock Text="全部关机" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,16,0" Command="{Binding RefreshCommand}"
                            ToolTip="重新读取状态（F5）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="AutoRefreshCheck" Style="{StaticResource ToggleSwitch}"
                              Content="自动刷新" IsChecked="True" VerticalAlignment="Center"
                              Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"
                              ToolTip="每 3 秒自动读取一次状态"/>
                </WrapPanel>
            </Grid>

            <!-- ============ 忙碌指示 ============ -->
            <ProgressBar Grid.Row="2" Height="2" IsIndeterminate="True" Background="Transparent"
                         BorderThickness="0" Foreground="{DynamicResource AccentBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

            <!-- ============ 内容 ============ -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="18,2,18,0" HorizontalContentAlignment="Center">
                <Grid>
                    <ItemsControl x:Name="DistroList" ItemsSource="{Binding Distros}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DistroCard}" HorizontalAlignment="Stretch"
                                        MaxWidth="900" Margin="0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 卡片头部 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Style="{StaticResource StatusDot}" Grid.Column="0"
                                                     VerticalAlignment="Center" Margin="2,0,0,0"/>

                                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="默认" Style="{StaticResource Sec}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Sec}"
                                                           FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource Badge}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Sec}" FontSize="11"/>
                                            </Border>
                                        </Grid>

                                        <!-- 操作区 -->
                                        <Grid Grid.Row="1" Margin="18,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource AccentButton}" Width="78" Margin="0,0,6,0"
                                                        IsEnabled="{Binding CanStart}"
                                                        Command="{Binding DataContext.StartCommand, ElementName=Root}"
                                                        CommandParameter="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Margin="0,0,6,0"/>
                                                        <TextBlock Text="开机" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource ActionButton}" Width="78" Margin="0,0,6,0"
                                                        IsEnabled="{Binding CanStop}"
                                                        Command="{Binding DataContext.StopCommand, ElementName=Root}"
                                                        CommandParameter="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="关机" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource ActionButton}" Width="78"
                                                        IsEnabled="{Binding CanStop}"
                                                        Command="{Binding DataContext.RestartCommand, ElementName=Root}"
                                                        CommandParameter="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="重启" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Tag="{Binding Name}"
                                                        Click="TerminalButton_Click" ToolTip="打开终端">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" FontSize="15"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Tag="{Binding Name}"
                                                        Click="FilesButton_Click" ToolTip="在资源管理器中打开文件">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="15"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Tag="{Binding Name}"
                                                        Click="MoreButton_Click" ToolTip="更多操作">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" FontSize="15"/>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="设为默认发行版" Tag="&#xE7B8;" Click="SetDefault_Click"/>
                                                            <MenuItem Header="复制 IP 地址" Tag="&#xE8C8;" Click="CopyIp_Click"/>
                                                            <MenuItem Header="复制发行版名称" Tag="&#xE8C8;" Click="CopyName_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="强制关机（不等待软关机）" Tag="&#xE7BA;"
                                                                      Click="ForceStop_Click"
                                                                      ToolTip="直接执行 wsl -t，跳过发行版内的关机流程"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,40" Visibility="Collapsed">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoftBrush}"
                                Margin="0,0,0,18">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" FontSize="32"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="未检测到 WSL 发行版" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Sec}" FontSize="12.5"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"
                                   Text="请先安装 WSL 并从 Microsoft Store 安装一个 Linux 发行版。"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="4" Background="{DynamicResource StatusBarBrush}" Height="38"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <TextBlock x:Name="StatusMessage" Style="{StaticResource Sec}" FontSize="12"
                               VerticalAlignment="Center" Text="就绪"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="WslVersionText" Style="{StaticResource Tert}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="LastUpdateText" Style="{StaticResource Tert}" FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
