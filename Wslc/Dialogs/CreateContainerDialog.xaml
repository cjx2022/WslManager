<Window x:Class="WslManager.Wslc.Dialogs.CreateContainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建容器"
        Width="820" Height="830"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True">
    <!-- 分层窗口（AllowsTransparency=True）会关掉 ClearType，卡片上必须自己开 ClearTypeHint； 排版模式由 Helpers/TextQuality.cs 按 DPI 设置。 -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wslc/Themes/Palette.Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Wslc/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="RowBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Block" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BarBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="DelBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/>
        </Style>
        <Style x:Key="AddBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
            RenderOptions.ClearTypeHint="Enabled">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.18" Color="{DynamicResource DialogShadowColor}"/>
        </Border.Effect>

        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
                <TextBlock Text="新建容器" FontSize="14.5" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <Button Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right"
                        Content="&#x2715;" Click="OnCancelClick"/>
            </Grid>

            <!-- 主体 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,0">
                <StackPanel>

                    <!-- 基本信息 -->
                    <TextBlock Text="基本信息" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,8"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="镜像 *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtImage" Style="{StaticResource RowBox}"
                             TextChanged="OnAnyChanged"/>
                    <ItemsControl x:Name="ListLocalImages" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AddBtn}" Margin="0,0,6,6"
                                        Content="{Binding}" Click="OnPickLocalImage"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="容器名称" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtName" Style="{StaticResource RowBox}" TextChanged="OnAnyChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="启动命令（可留空，用镜像默认）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCommand" Style="{StaticResource RowBox}" TextChanged="OnAnyChanged"
                                     ToolTip="留空 = 用镜像自带的默认命令。⚠ 通过「备份与清理」导入的镜像没有默认命令，必须在这里填一个常驻命令（例如 sleep infinity 或 sh），否则容器无法启动。"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                        <CheckBox x:Name="ChkDetach" Style="{StaticResource ModernCheckBox}" Content="后台运行"
                                  IsChecked="True" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                        <CheckBox x:Name="ChkAutoRemove" Style="{StaticResource ModernCheckBox}" Content="停止后自动删除"
                                  Margin="18,0,0,0" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                        <CheckBox x:Name="ChkTty" Style="{StaticResource ModernCheckBox}" Content="分配终端 (-it)"
                                  Margin="18,0,0,0" IsChecked="True"
                                  ToolTip="默认勾选：交互式 shell 没有终端会立刻读到 EOF 退出"
                                  Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                    </StackPanel>

                    <!-- 端口映射 -->
                    <Border Style="{StaticResource Block}" Margin="0,12,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="端口映射" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <Button Style="{StaticResource AddBtn}" HorizontalAlignment="Right"
                                        Content="+ 添加端口" Click="OnAddPort"/>
                            </Grid>
                            <TextBlock FontSize="11.5" Margin="0,4,0,8" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" LineHeight="17"
                                       Text="宿主端口 : 容器端口，例如 8080 : 80。&#10;只有要从 Windows 访问容器里的服务时才需要填。"/>
                            <ItemsControl x:Name="ListPorts">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource RowBox}"
                                                     Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnAnyChanged"/>
                                            <TextBlock Grid.Column="1" Text=":" Margin="8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource RowBox}"
                                                     Text="{Binding ContainerPort, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnAnyChanged"/>
                                            <TextBlock Grid.Column="3" Text="→ 宿主 : 容器" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" FontSize="11.5"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <Button Grid.Column="4" Style="{StaticResource DelBtn}" Content="✕"
                                                    Click="OnRemovePort"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 卷挂载 -->
                    <Border Style="{StaticResource Block}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="目录挂载" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <Button Style="{StaticResource AddBtn}" HorizontalAlignment="Right"
                                        Content="+ 添加挂载" Click="OnAddVolume"/>
                            </Grid>
                            <TextBlock FontSize="11.5" Margin="0,4,0,8" Foreground="{DynamicResource MutedBrush}"
                                       Text="宿主路径 : 容器路径，例如 D:\data : /data"/>
                            <ItemsControl x:Name="ListVolumes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="262"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 宿主路径支持「选择…」挑文件夹：手打 Windows 路径太容易错 -->
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Style="{StaticResource RowBox}"
                                                         Text="{Binding HostPath, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="OnAnyChanged"/>
                                                <Button Grid.Column="1" Style="{StaticResource AddBtn}"
                                                        Margin="4,0,0,0" Content="选择…"
                                                        ToolTip="从磁盘里挑一个文件夹，不用手打路径"
                                                        Click="OnPickHostFolder"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text=":" Margin="8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource RowBox}"
                                                     Text="{Binding ContainerPath, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnAnyChanged"/>
                                            <CheckBox Grid.Column="3" Style="{StaticResource ModernCheckBox}" Content="只读"
                                                      Margin="10,0,0,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding ReadOnly}" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                                            <Button Grid.Column="5" Style="{StaticResource DelBtn}" Content="✕"
                                                    Click="OnRemoveVolume"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 环境变量 -->
                    <Border Style="{StaticResource Block}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="环境变量" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <Button Style="{StaticResource AddBtn}" HorizontalAlignment="Right"
                                        Content="+ 添加变量" Click="OnAddEnv"/>
                            </Grid>
                            <ItemsControl x:Name="ListEnv" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource RowBox}"
                                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnAnyChanged"/>
                                            <TextBlock Grid.Column="1" Text="=" Margin="8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource RowBox}"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnAnyChanged"/>
                                            <Button Grid.Column="3" Style="{StaticResource DelBtn}" Content="✕"
                                                    Click="OnRemoveEnv"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 高级 -->
                    <Border Style="{StaticResource Block}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="高级选项" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="重启策略（always / on-failure / unless-stopped）"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtRestart" Style="{StaticResource RowBox}"
                                             TextChanged="OnAnyChanged"
                                             ToolTip="⚠ wslc run 暂不支持 --restart 选项（2026-10-10 实测），填写也不会下发。"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="工作目录 (-w)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtWorkDir" Style="{StaticResource RowBox}"
                                             TextChanged="OnAnyChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- 网络：默认项 = 不下发 network 参数，语义与旧版本完全一致 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="网络" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbNetwork" Style="{StaticResource ModernComboBox}"
                                              Height="30" VerticalContentAlignment="Center"
                                              SelectionChanged="OnAnyChanged"
                                              ToolTip="在「容器网络管理」页创建的网络会出现在这里；选默认即用 wslc 的 bridge 网络"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Text="选默认即可；选自定义网络后容器会拿到该网段的 IP。"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 命令预览 -->
            <Border Grid.Row="2" Margin="18,6,18,10" Background="{DynamicResource LogBgBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="10,8">
                <StackPanel>
                    <TextBlock Text="等价命令" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="TxtPreview" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap"
                             Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>

            <!-- 按钮 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="18,0,18,16">
                <Button Style="{StaticResource GhostButton}" Content="取消" Padding="20,8"
                        Click="OnCancelClick"/>
                <Button Style="{StaticResource PrimaryButton}" Content="创建容器" Padding="20,8"
                        Margin="10,0,0,0" Click="OnCreateClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
