<Window x:Class="WslManager.Wslc.Dialogs.EnvCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="环境检查"
        Width="680" Height="640" MinWidth="560" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" FontSize="13.5"
        UseLayoutRounding="True">
    <!-- v2.4：环境检查从「环境与安装」页的内联折叠面板改成弹出卡片。
         分层窗口（AllowsTransparency=True）会关掉 ClearType，卡片上必须自己开 ClearTypeHint。 -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wslc/Themes/Palette.Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Wslc/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <h:BoolToVisibilityConverter x:Key="BoolVisConv" xmlns:h="clr-namespace:WslManager.Wslc.Helpers"/>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>

            <!-- 状态色：状态在 CheckVm.Status 里，颜色由触发器取调色板（切主题跟着换） -->
            <Style x:Key="CheckState" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Warn">
                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Fail">
                        <Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
            RenderOptions.ClearTypeHint="Enabled">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.18" Color="{DynamicResource DialogShadowColor}"/>
        </Border.Effect>

        <Grid RenderOptions.ClearTypeHint="Enabled">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="环境检查" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="TxtSub" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right"
                        Content="&#x2715;" Click="OnCloseClick"/>
            </Grid>

            <!-- 进度条 -->
            <ProgressBar x:Name="BarCheck" Grid.Row="1" Height="2" IsIndeterminate="True"
                         Visibility="Collapsed" Margin="20,0,20,4"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource AccentBrush}"/>

            <!-- 检查项列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="20,8,20,0">
                <ItemsControl x:Name="ListChecks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Top" Margin="0,3,0,0"
                                           Style="{StaticResource CheckState}"/>
                                <StackPanel Grid.Column="1" Margin="6,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CheckState}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="11.8" TextWrapping="Wrap"
                                               Margin="0,2,0,0" LineHeight="17"
                                               Foreground="{DynamicResource SubTextBrush}"/>
                                    <TextBlock Text="{Binding FixMessage}" FontSize="11.5" TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding HasFixMessage, Converter={StaticResource BoolVisConv}}"/>
                                    <TextBlock Text="查看文档" FontSize="11.5" Margin="0,2,0,0"
                                               Cursor="Hand"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Tag="{Binding DocUrl}"
                                               MouseLeftButtonUp="OnDocClick"
                                               Visibility="{Binding HasDoc, Converter={StaticResource BoolVisConv}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource RowButton}" Margin="0"
                                        VerticalAlignment="Top"
                                        Tag="{Binding}" Click="OnFixItemClick"
                                        Content="{Binding FixButtonText}"
                                        IsEnabled="{Binding CanFix}"
                                        Visibility="{Binding CanFix, Converter={StaticResource BoolVisConv}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部：一键修复 + 关闭 -->
            <Grid Grid.Row="3" Margin="20,12,20,18">
                <TextBlock x:Name="TxtHint" FontSize="11.5" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnFixAll" Style="{StaticResource GhostButton}" Padding="16,7"
                            Margin="0,0,8,0" Content="一键修复" IsEnabled="False"
                            ToolTip="按顺序修复所有可自动处理的项"
                            Click="OnFixAllClick"/>
                    <Button Style="{StaticResource GhostButton}" Padding="20,8" Content="关闭" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
